{
    "description": "CI harness for bredabeds/magento-hyva-checkout-affirm: Magento Open Source packages from the Mage-OS mirror, Affirm from Packagist, MIT test doubles for the Hyvä Checkout, Hyvä theme and Magewire classes the module uses. Never installed with the module.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "affirm/magento2": "^4.0.11",
        "magento/framework": "^103.0",
        "magento/module-admin-notification": "^100.4",
        "magento/module-backend": "^102.0",
        "magento/module-catalog": "^104.0",
        "magento/module-checkout": "^100.4",
        "magento/module-cron": "^100.4",
        "magento/module-customer": "^103.0",
        "magento/module-payment": "^100.4",
        "magento/module-quote": "^101.2",
        "magento/module-sales": "^103.0",
        "magento/module-sales-rule": "^101.2",
        "magento/module-store": "^101.1",
        "magento/module-ui": "^101.2"
    },
    "require-dev": {
        "bitexpert/phpstan-magento": "^0.32",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://mirror.mage-os.org/",
            "only": [
                "magento/*"
            ]
        }
    ],
    "autoload": {
        "psr-4": {
            "Hyva\\CheckoutAffirm\\": "../../src/"
        },
        "files": [
            "stubs/magewire.php",
            "stubs/hyva-checkout.php",
            "stubs/hyva-theme-module.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Hyva\\CheckoutAffirm\\Test\\": "../../Test/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    }
}
