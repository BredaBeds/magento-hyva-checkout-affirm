<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/routes.xsd">
    <!-- Route id shared with Hyva_AstoundAffirm (same id, own module node) so both modules can be installed
         together or alone. -->
    <router id="standard">
        <route id="hyva_affirm" frontName="hyva_affirm">
            <module name="Hyva_CheckoutAffirm"/>
        </route>
    </router>
</config>
