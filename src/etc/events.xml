<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- QuoteManagement dispatches this for placeOrder() and submit() (REST, GraphQL, PayPal Express, admin);
         checkout_submit_before is dispatched by placeOrder only. -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="hyva_affirm_block_unresolved_attempts" instance="Hyva\CheckoutAffirm\Observer\BlockUnresolvedAttempts"/>
    </event>
    <!-- Multishipping places its orders without QuoteManagement; this event carries the quote and runs before payment. -->
    <event name="checkout_type_multishipping_create_orders_single">
        <observer name="hyva_affirm_block_unresolved_attempts" instance="Hyva\CheckoutAffirm\Observer\BlockUnresolvedAttempts"/>
    </event>
</config>
