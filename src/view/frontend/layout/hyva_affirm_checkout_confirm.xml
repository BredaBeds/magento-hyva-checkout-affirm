<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <meta name="robots" content="NOINDEX,NOFOLLOW"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block name="hyva.affirm.checkout.attempt.status"
                   template="Hyva_CheckoutAffirm::checkout/attempt/in-progress.phtml"
                   cacheable="false"/>
            <!-- While another request places the order, asks the confirm URL again in the background (?poll=1) and
                 loads the page anew only once the answer is no longer "in progress": the page is not reloaded
                 under the shopper while it waits (WCAG 2.2.1; it used to be a 3 s meta refresh). Without script
                 the status block's "Check the status now" link does the same by hand. The confirm controller
                 removes this block when the attempt waits for the merchant. -->
            <block name="hyva.affirm.checkout.attempt.refresh"
                   template="Hyva_CheckoutAffirm::checkout/attempt/status-check.phtml"
                   after="hyva.affirm.checkout.attempt.status"/>
        </referenceContainer>
    </body>
</page>
