<?xml version="1.0" encoding="UTF-8"?>
<!-- Unit tests. On a Magento installation run them through Magento's configuration instead:
     vendor/bin/phpunit -c dev/tests/unit/phpunit.xml.dist <path-to-package>/Test/Unit
     In CI this file is used with the harness bootstrap, Test/ci/bootstrap.php (see Test/ci/README.md). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="Test/ci/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true">
    <testsuites>
        <testsuite name="unit">
            <directory>Test/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
