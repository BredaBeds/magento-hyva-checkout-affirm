{
    "name": "bredabeds/magento-hyva-checkout-affirm",
    "description": "Hyvä Checkout integration for Affirm's Magento 2 extension (affirm/magento2): Affirm as a payment method in Hyvä Checkout, modal and redirect flows",
    "type": "magento2-module",
    "version": "0.2.1",
    "license": "MIT",
    "keywords": [
        "magento2",
        "hyva",
        "hyva-checkout",
        "affirm",
        "payments"
    ],
    "homepage": "https://github.com/BredaBeds/magento-hyva-checkout-affirm",
    "authors": [
        {
            "name": "Breda Beds",
            "homepage": "https://github.com/BredaBeds"
        }
    ],
    "support": {
        "issues": "https://github.com/BredaBeds/magento-hyva-checkout-affirm/issues",
        "source": "https://github.com/BredaBeds/magento-hyva-checkout-affirm"
    },
    "require": {
        "php": "^8.1",
        "affirm/magento2": "^4.0.11",
        "composer-runtime-api": "^2.0",
        "hyva-themes/magento2-hyva-checkout": "^1.3.14 || ^3.0",
        "hyva-themes/magento2-theme-module": "^1.3.11",
        "magento/framework": "^103.0",
        "magento/module-admin-notification": "^100.4",
        "magento/module-backend": "^102.0",
        "magento/module-catalog": "^104.0",
        "magento/module-checkout": "^100.4",
        "magento/module-cron": "^100.4",
        "magento/module-customer": "^103.0",
        "magento/module-payment": "^100.4",
        "magento/module-quote": "^101.2",
        "magento/module-sales": "^103.0",
        "magento/module-sales-rule": "^101.2",
        "magento/module-store": "^101.1",
        "magento/module-ui": "^101.2",
        "magewirephp/magewire": "^1.13.3 || ^3.7.2"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Hyva\\CheckoutAffirm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hyva\\CheckoutAffirm\\Test\\": "Test/"
        }
    }
}
